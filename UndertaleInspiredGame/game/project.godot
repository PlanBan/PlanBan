; Engine configuration file.
; WURZELHERZ — original narrative RPG inspired by turn-based dodge-box RPG structure.
config_version=5

[application]
config/name="WURZELHERZ"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7")

[autoload]
GameState="*res://scripts/game_state.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

audio/driver/enable_input=false

[input]
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
confirm={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":90),Object(InputEventKey,"physical_keycode":32),Object(InputEventKey,"physical_keycode":4194309)]}
cancel={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":88),Object(InputEventKey,"physical_keycode":4194305)]}
interact={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventKey,"physical_keycode":90)]}
pause={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Interactable"
2d_physics/layer_4="Encounter"
2d_physics/layer_5="BattleSoul"
2d_physics/layer_6="BattleProjectile"
