[node name="MossChild" parent="." instance=ExtResource("6_npc")]
position = Vector2(500,455)
neutral_dialogue = "Ein kleines Mooswesen zieht die Mütze tiefer.|\"Der Ritter tut gefährlich. Eigentlich sammelt er alte Geschichten.\"|\"Wenn er dich anschreit, frag ihn, woran er sich erinnert.\""
mercy_dialogue = "Das Mooswesen lächelt.|\"Der Novize hat dich vorbeigelassen? Dann kannst du ja doch zuhören.\"|\"Der Moosritter merkt so etwas.\""
fight_dialogue = "Das Mooswesen weicht einen Schritt zurück.|\"Der Novize ist still geworden... zu still.\"|\"Beim Ritter hilft Stärke vielleicht. Aber sie kostet immer etwas.\""
first_talk_flag = &"met_moss_child"

