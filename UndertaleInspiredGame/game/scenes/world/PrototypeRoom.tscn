[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/prototype_room.gd" id="1_script"]

[node name="PrototypeRoom" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025,0.035,0.03,1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "PROLOG"
horizontal_alignment = 1

[node name="Text" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65,0.72,0.66,1)
theme_override_font_sizes/font_size = 17
text = "Das Grundgerüst steht.\nDie erste begehbare Kammer entsteht in Stage 2."
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(240,48)
layout_mode = 2
text = "ZURÜCK ZUM MENÜ"

[connection signal="pressed" from="Center/VBox/BackButton" to="." method="_on_back_button_pressed"]
