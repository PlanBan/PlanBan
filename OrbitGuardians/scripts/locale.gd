static var cache: Dictionary = {}
static var missing: Dictionary = {}

static func translate(source: String, language: String, depth: int = 0) -> String:
	if language == "ru" or depth > 4: return source
	var key = language + ":" + source
	if cache.has(key): return cache[key]
	if STRINGS.has(source):
		cache[key] = STRINGS[source][language]
		return cache[key]
	if compiled.is_empty():
		for item in PATTERNS:
			var entry = item.duplicate()
			entry.regex = RegEx.new()
			entry.regex.compile(item.pattern)
			compiled.append(entry)
