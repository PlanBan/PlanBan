		for i in range(item.types.size()):
			var value = matched.get_string(i + 1)
			match item.types[i]:
				"d": values.append(int(value))
				"f": values.append(float(value))
				_: values.append(translate(value, language, depth + 1))
		var result: String = STRINGS[item.source][language] % values
		cache[key] = result
		return result
	for character in source:
		var code = character.unicode_at(0)
		if code >= 0x400 and code <= 0x4ff:
