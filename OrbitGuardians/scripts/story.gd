extends RefCounted
class_name OrbitStory

const INTRO = [
	{"speaker": "КАПИТАН РЕЯ", "text": "Ядро Астра — сердце нашего дома. Пока оно светится, станция живёт, а наши роботы защищают колонию.", "scene": "home"},
	{"speaker": "ОРИОН · БОРТОВОЙ ИИ", "text": "Капитан, неопознанные корабли выходят из тени планеты. Их орудия направлены на нас. Это армия машин!", "scene": "raid"},
	{"speaker": "ВОЕНАЧАЛЬНИК НУЛЬ", "text": "Ваше ядро станет сердцем Нексуса. Сопротивление лишь отсрочит неизбежное.", "scene": "raid"},
	{"speaker": "КАПИТАН РЕЯ", "text": "Разверните защитников! Удержим шлюз, пока гражданские добираются до корабля. Мы не бросим их.", "scene": "home"}
]
const THEFT = [
	{"speaker": "ОРИОН · БОРТОВОЙ ИИ", "text": "Главный рубеж уничтожен. Машины забрали ядро Астра. Мы проиграли этот бой... но корабль ещё цел.", "scene": "ruins"},
	{"speaker": "КАПИТАН РЕЯ", "text": "Тогда это не конец. Запасной реактор даст нам энергию. Взлетаем и идём по их следу. Мы вернём наше сердце.", "scene": "ship"},
	{"speaker": "ОРИОН · БОРТОВОЙ ИИ", "text": "Маршрут найден: Вердия, Борея, Игнис, Аурика и Нексус. На каждой планете нас ждут другие машины. Готовьтесь к прыжку.", "scene": "ship"}
]
const ENDING = [
	{"speaker": "ВОЕНАЧАЛЬНИК НУЛЬ", "text": "Невозможно... Столько миров, столько моих армий. Как вы дошли до сердца Нексуса?", "scene": "ruins"},
	{"speaker": "КАПИТАН РЕЯ", "text": "Ты забрал наше ядро, но не смог отнять надежду. Мы выросли сильнее с каждым миром. Теперь Астра возвращается домой.", "scene": "core"},
	{"speaker": "ОРИОН · БОРТОВОЙ ИИ", "text": "Ядро подключено. Колония снова получает энергию. Пятьдесят миссий позади. Курс — домой, капитан.", "scene": "ship"}
]

static func lines(context: String) -> Array:
	match context:
		"theft": return THEFT
		"ending": return ENDING
		_: return INTRO
